{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-care-finder",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "family-care-finder", "database_id": "76743daf-a82c-4dbc-9fea-40cab8fc7857" }
  ]
  // Anonymous usage counts live in the D1 database above (table: worker/schema.sql).
}
